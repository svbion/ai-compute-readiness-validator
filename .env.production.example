# Production environment for GPU Validator
# Copy to .env.production on the server and adjust values if needed.

PORT=3000
PYTHONUNBUFFERED=1
VITE_GPU_VALIDATOR_CONTACT_EMAIL=access@gpuvalidator.com

# NODE_ENV is intentionally set by deploy/systemd/ai-factory-validator.service
# and npm build commands, not by this dotenv file. Vite warns when NODE_ENV is
# present in .env.production.

# Public production domain documented for GPU Validator deployment.
# The repo-owned Caddyfile is configured for gpuvalidator.com and www.gpuvalidator.com.
AI_FACTORY_DOMAIN=gpuvalidator.com
AI_FACTORY_ENABLE_CADDY=false
AI_FACTORY_BRANCH=hermes-mvp
AI_FACTORY_APP_DIR=/opt/ai-factory-validator
AI_FACTORY_SERVICE_NAME=ai-factory-validator.service
AI_FACTORY_APP_USER=ai-validator
AI_FACTORY_HEALTH_RETRIES=30
AI_FACTORY_HEALTH_RETRY_DELAY=2
AI_FACTORY_HEALTH_TIMEOUT=10

# Production deployment keeps auth explicit via AI_FACTORY_AUTH_REQUIRED=true;
# the systemd service also sets NODE_ENV=production at runtime.
# This file uses dotenv syntax, not arbitrary shell script syntax. Deployment
# scripts safely parse selected KEY=VALUE records without shell evaluation.
# Keep values containing $, such as scrypt password hashes, single-quoted for
# human clarity and Node dotenv compatibility. Never use command substitutions
# or commit real reviewer credentials.
AI_FACTORY_AUTH_REQUIRED=true
AI_FACTORY_SESSION_SECRET='replace-with-at-least-32-random-characters'
AI_VALIDATOR_USER_STORE=/opt/ai-factory-validator/shared/users/store.json
# Optional single-reviewer fallback only. Primary production authentication uses
# the multi-user store above and administrator bootstrap via ai-validator users.
AI_FACTORY_REVIEWER_USERNAME=
AI_FACTORY_REVIEWER_PASSWORD_HASH=
AI_FACTORY_SESSION_TTL_SECONDS=3600
AI_FACTORY_COOKIE_SECURE=true

# Optional deployment-only verification token. Leave empty unless running
# authenticated deploy/verify.sh checks from localhost or CI.
AI_FACTORY_AUTH_TEST_BYPASS_TOKEN='replace-with-local-verification-token'

# Proposed RunPod outbound-polling agent secret for the deadline MVP. This is
# documented in docs/RUNPOD_MVP_ARCHITECTURE.md and should be stored in the
# backend environment and RunPod secrets when the agent API is implemented.
# Do not pass real values on command lines or commit them.
GPUVALIDATOR_AGENT_TOKEN=
