# Copy to agent/.env on the RunPod pod and fill in the token there. Do not commit real secrets.
GPUVALIDATOR_API_URL="https://gpuvalidator.com"
GPUVALIDATOR_AGENT_TOKEN="<secure token>"
GPUVALIDATOR_AGENT_NAME="runpod-4gpu-01"
GPUVALIDATOR_POLL_INTERVAL="3"
GPUVALIDATOR_HEARTBEAT_INTERVAL="10"
GPUVALIDATOR_COMMAND_TIMEOUT="20"
GPUVALIDATOR_TLS_VERIFY="true"
GPUVALIDATOR_LOG_LEVEL="INFO"
GPUVALIDATOR_AGENT_ID_FILE="./agent/.runpod-agent-id"
